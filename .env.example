# ─── WalletConnect ───────────────────────────────────────────────────────────
# Get your free Project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here

# ─── Supabase ────────────────────────────────────────────────────────────────
# Required for real-time chat, contacts, and user profiles.
# 1. Create a free project at https://supabase.com
# 2. Run supabase-schema.sql in your project's SQL Editor
# 3. Go to Project Settings → API and copy the values below
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key_here

# ─── Contract Addresses (filled in after deployment) ─────────────────────────
# Run: cd contracts && npm run deploy:fuji  →  copy printed address below
NEXT_PUBLIC_FUNDPOOL_FUJI=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FUNDPOOL_MAINNET=0x0000000000000000000000000000000000000000
